# ───── Supabase (Project Settings → API) ─────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET — server only, never prefix with NEXT_PUBLIC_

# ───── Admin login ─────
ADMIN_PASSWORD=choose-a-long-password
# Optional (a safe default is derived from the password): ADMIN_SESSION_SECRET=any-long-random-string

# ───── Cloudinary (product photos) — Dashboard → Settings → API Keys ─────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# ───── Public site URL (used in WhatsApp links + M-PESA callback) ─────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ───── M-PESA Daraja (optional — leave blank to take payments manually via WhatsApp) ─────
MPESA_ENV=sandbox                 # or: production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # use CustomerBuyGoodsOnline for a Till number
MPESA_PARTY_B=                    # Till number if using Buy Goods; defaults to MPESA_SHORTCODE
MPESA_CALLBACK_SECRET=any-long-random-string
